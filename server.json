{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.SergiuPogor/curlshot",
  "title": "CurlShot",
  "description": "Screenshots of any public web page as PNG, JPEG, WebP, PDF or a scrolling video.",
  "version": "1.0.1",
  "websiteUrl": "https://curlshot.com/docs/guides/ai-agents?utm_source=mcp-registry&utm_medium=listing&utm_campaign=dist-q4",
  "repository": {
    "url": "https://github.com/SergiuPogor/curlshot-mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://curlshot.com/icons/logo-512.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://curlshot.com/api/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Your CurlShot API key as \"Bearer YOUR_API_KEY\". Free key at https://curlshot.com/register",
          "value": "Bearer {api_key}",
          "isRequired": true,
          "isSecret": true,
          "variables": {
            "api_key": {
              "description": "CurlShot API key",
              "isRequired": true,
              "isSecret": true
            }
          }
        }
      ]
    }
  ]
}
